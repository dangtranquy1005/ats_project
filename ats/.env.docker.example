# Copy to .env.docker and supply the credentials used by your local services.
ATS_HTTP_PORT=8082
SERVER_PORT=8081
TZ=Asia/Ho_Chi_Minh
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Ho_Chi_Minh
SPRING_APPLICATION_NAME=ats-project
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/atsproject
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=30MB
MINIO_URL=http://host.docker.internal:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=cv-files
JWT_SECRET=replace-with-the-same-secret-as-your-local-backend
JWT_EXPIRATION=86400000
ATS_SKILLS_SEED_ENABLED=false
NLP_BASE_URL=http://nlpservice:8000
NLP_CONNECT_TIMEOUT=3s
NLP_READ_TIMEOUT=30s
NLP_DOCKER_NETWORK=nlpservice_default
